# Anthropic API key - required only to run the committee against real models.
# Without it, ALTOVIX_LLM=mock runs the full chain deterministically offline.
ANTHROPIC_API_KEY=

# claude-opus-4-6 / claude-sonnet-4-6 etc. Per-agent overrides live in src/core/agents/registry.ts
ALTOVIX_MODEL=claude-sonnet-4-6

# real | mock
ALTOVIX_LLM=real

# Path to the SQLite database file
ALTOVIX_DB=./altovix.db

# Market data provider: schwab | stooq | yahoo | csv
# (schwab needs the keys below and a one-time `npm run schwab -- login`)
ALTOVIX_MARKET_PROVIDER=stooq

# Charles Schwab Trader API - from developer.schwab.com, App Details for your app.
# Type these in yourself. They belong in .env only: .env is git-ignored, and this file is
# the only copy. Callback must match the app's Callback URL character for character.
SCHWAB_APP_KEY=
SCHWAB_APP_SECRET=
SCHWAB_CALLBACK_URL=https://127.0.0.1:8182
# Where the login tokens are cached (data/ is git-ignored). Refresh token lasts 7 days.
SCHWAB_TOKEN_FILE=./data/schwab-tokens.json

# Where CSV price files live when provider=csv (one file per symbol, e.g. SPY.csv)
ALTOVIX_CSV_DIR=./data/prices

# Benchmarks tracked for every snapshot and every committee run
ALTOVIX_BENCHMARKS=SPY,QQQ
