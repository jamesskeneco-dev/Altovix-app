# Anthropic API key - required only to run the committee against real models.
# Without it, ALTOVIX_LLM=mock runs the full chain deterministically offline.
ANTHROPIC_API_KEY=

# claude-opus-4-6 / claude-sonnet-4-6 etc. Per-agent overrides live in src/core/agents/registry.ts
ALTOVIX_MODEL=claude-sonnet-4-6

# real | mock
ALTOVIX_LLM=real

# Path to the SQLite database file
ALTOVIX_DB=./altovix.db

# Market data provider: stooq | yahoo | csv
ALTOVIX_MARKET_PROVIDER=stooq

# Where CSV price files live when provider=csv (one file per symbol, e.g. SPY.csv)
ALTOVIX_CSV_DIR=./data/prices

# Benchmarks tracked for every snapshot and every committee run
ALTOVIX_BENCHMARKS=SPY,QQQ
